          },
          "expr": "probe_success{job=\"blackbox-agent-gw\",instance=\"http://172.18.0.6:8080/healthz/upstream\"}",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
